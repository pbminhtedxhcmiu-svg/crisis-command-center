# === Crisis Command Center — env mẫu ===
# Copy thành .env và điền giá trị thật.

# SQLite (mặc định, dễ phát hành): file nằm trong thư mục prisma
DATABASE_URL="file:./dev.db"
# Trong Docker mount volume: dùng đường dẫn tuyệt đối
# DATABASE_URL="file:/app/data/prod.db"

# Bắt buộc thiết lập ở production (Next.js dùng để ký session cookie)
# Tạo nhanh: openssl rand -base64 32
AUTH_SECRET=""

# Phiên bản app hiển thị ở /api/health
APP_VERSION="1.0.0"

# Node environment
NODE_ENV="development"
